# ========================================================================
# 역할: Nav2 서비스 (launch_nav2.sh). 위치추정·모터 관리자가 먼저 떠 있어야 한다.
# ========================================================================
[Unit]
Description=burger2 persistent nav2
Requires=burger2-localization.service burger2-motion-owner.service
After=burger2-localization.service burger2-motion-owner.service

[Service]
Type=simple
ExecStart=/bin/bash /home/ubuntu/final_robot_ws/robot/burger2/navigation/launch_nav2.sh
KillSignal=SIGINT
TimeoutStopSec=20
Restart=no
