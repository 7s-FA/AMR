[Unit]
Description=Burger1 prepared waypoint ROS connections (no idle motion)
PartOf=burger1-nav-control.service

[Service]
Type=simple
ExecStart=/bin/bash /home/ubuntu/final_robot_ws/robot/burger1/navigation/start_waypoint_worker.sh
Environment=ROS_DOMAIN_ID=40
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=0
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=12
UMask=0077
