# ========================================================================
# 역할: 관제 준비 작업자 서비스 (start_host_ready.sh). 실제 실행 경로는 materialize/install-services 가 바꿔 넣는다.
# ========================================================================
[Unit]
Description=burger2 persistent host readiness (no motion goals)
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash /home/ubuntu/final_robot_ws/robot/burger2/navigation/start_host_ready.sh
KillSignal=SIGINT
TimeoutStopSec=8
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
